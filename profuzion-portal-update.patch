+  line-height: 1.35;
+  letter-spacing: -0.02em;
+  margin: 0;
+  overflow-wrap: anywhere;
+}
+.asset-meta {
+  font-size: 12px;
+  color: #aeb5b9;
+  overflow-wrap: anywhere;
+  margin: 0;
+}
+.asset-notes {
