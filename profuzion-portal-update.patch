+  .guide-logo-grid,
+  .guide-type-grid {
+    grid-template-columns: 1fr;
+  }
+  .asset-category-head {
+    align-items: flex-start;
+    flex-direction: column;
+    gap: 12px;
+  }
+  .guide-cover h2 {
+    max-width: 100%;
+    font-size: 42px;
+  }
+  .guide-cover-bottom {
+    flex-direction: column;
+    gap: 10px;
+    margin-top: 30px;
+  }
+  .guide-index {
+    gap: 6px;
+  }
+  .guide-index a {
+    padding: 10px;
+    font-size: 12px;
+  }
+  .guide-colours {
+    grid-template-columns: 1fr;
+  }
+  .guide-colour-swatch {
+    height: 150px;
+  }
+  .guide-section {
+    padding: 34px 0;
+  }
+  .asset-library .section-heading {
+    align-items: flex-start;
+    flex-direction: column;
+    gap: 16px;
+  }
+  .asset-library .section-heading .btn {
+    width: 100%;
+  }
+  .guide-cover:after {
+    opacity: 0.25;
+  }
+  .guide-type-sample {
+    font-size: 42px;
+  }
+}
