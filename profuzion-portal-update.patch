+    gap: 12px;
+  }
+  .guide-colour-swatch {
+    height: 130px;
+    padding: 12px;
+  }
+  .guide-logo-stage {
+    height: 180px;
+    padding: 24px;
+  }
+}
+@media (max-width: 620px) {
