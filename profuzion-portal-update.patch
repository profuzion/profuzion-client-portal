+export default async function Guidelines({params}: {params:Promise<{slug:string}>}) {
+  const {slug} = await params;
+  const {user,clientId} = await requireClientAccess(slug);
+  const client = await getClient(slug);
+  const {published:kit} = await getBrand(clientId,client.name);
+  return <Shell user={user} clientSlug={slug} title="Brand guidelines" actions={<Link href={`/c/${slug}`} className="btn btn-outline">Back to workspace</Link>}>
+    {!kit ? <div className="panel"><p>Your approved brand guidelines will appear here once Profuzion publishes them.</p></div> : <div className="brand-workspace">
+      <div className="panel"><h2>{kit.name}</h2><p>{kit.tagline}</p><div className="brand-logo-gallery">{([['Primary logo',kit.logo],['Logo on dark',kit.logoOnDark]] as const).filter(([,url])=>url).map(([label,url])=><a key={label} href={url} target="_blank" rel="noopener noreferrer" className="brand-logo-tile" style={{background:label==='Logo on dark'?kit.sidebar:'#ffffff'}}><img src={url} alt={label}/><span className="brand-logo-caption">Open {label.toLowerCase()}</span></a>)}</div></div>
+      <div className="panel"><h2>Colour palette</h2><div className="brand-palette">{([['Primary',kit.primary],['Secondary',kit.secondary],['Sidebar',kit.sidebar]] as const).map(([label,colour])=><div key={label}><span style={{background:colour}}/><strong>{label}</strong><code>{colour}</code></div>)}</div><h3>Typography</h3><p>Headings: {kit.headingFont}. Body: {kit.bodyFont}.</p></div>
+      {([['Purpose and positioning',kit.purpose],['Audience',kit.audience],['Brand voice',kit.voice],['Logo usage',kit.logoRules],['Visual direction',kit.imagery]] as const).filter(([,text])=>text).map(([title,text])=><section className="panel" key={title}><h2>{title}</h2><p style={{whiteSpace:'pre-wrap'}}>{text}</p></section>)}
+    </div>}
+  </Shell>;
+}
