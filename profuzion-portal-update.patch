@@ -0,0 +1,52 @@
+import nodemailer from "nodemailer";
+import { sql } from "@/lib/db";
+export const emailConfigured = () =>
+  Boolean(process.env.SMTP_HOST && process.env.SMTP_FROM);
+export async function notifyAccount(
+  userId: string,
+  kind: "welcome" | "password_change" | "password_reset",
+) {
+  const [user] = await sql<{
+    email: string;
+    name: string;
+    notify_welcome: boolean;
+    notify_password_change: boolean;
+    notify_password_reset: boolean;
+  }>(
+    "SELECT email,name,notify_welcome,notify_password_change,notify_password_reset FROM users WHERE id=$1",
+    [userId],
+  );
+  if (!user || !user[`notify_${kind}`]) return "disabled";
+  if (!emailConfigured()) return "unconfigured";
+  const subjects = {
+    welcome: "Your Profuzion workspace is ready",
+    password_change: "Your Profuzion password was changed",
+    password_reset: "Your Profuzion password was reset",
+  };
+  const text =
+    kind === "welcome"
+      ? "Your account is ready. Your agency contact will share your login details separately."
+      : "An administrator updated your password. Contact Profuzion if you were not expecting this change. Your login details will be shared separately.";
+  try {
+    const transport = nodemailer.createTransport({
+      host: process.env.SMTP_HOST,
+      port: Number(process.env.SMTP_PORT || 587),
+      secure: process.env.SMTP_SECURE === "true",
+      requireTLS: process.env.SMTP_SECURE !== "true",
+      auth: process.env.SMTP_USER
+        ? { user: process.env.SMTP_USER, pass: process.env.SMTP_PASSWORD }
+        : undefined,
+      connectionTimeout: 10000,
+      socketTimeout: 15000,
+    });
+    await transport.sendMail({
+      from: process.env.SMTP_FROM,
+      to: user.email,
+      subject: subjects[kind],
+      text: `Hello ${user.name},\n\n${text}\n\nProfuzion Studio`,
+    });
+    return "sent";
+  } catch {
+    return "failed";
+  }
+}
diff --git a/lib/portal-validation.ts b/lib/portal-validation.ts
new file mode 100644
index 0000000..6b331b3
--- /dev/null
+++ b/lib/portal-validation.ts
@@ -0,0 +1,39 @@
+export const uuid =
+  /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+export const ticketStatuses = {
+  open: "Open",
+  in_progress: "In progress",
+  waiting: "Waiting for client",
+  resolved: "Resolved",
+} as const;
+export const ticketCategories = {
+  change: "Change request",
+  question: "Question",
+  issue: "Troubleshooting",
+} as const;
+export function field(form: FormData, key: string, max = 10000) {
+  const result = String(form.get(key) ?? "").trim();
+  if (result.length > max)
+    throw new Error("A field exceeds its maximum length.");
+  return result;
+}
+export function accountInput(form: FormData) {
+  const name = field(form, "name", 150),
+    email = field(form, "email", 254).toLowerCase(),
+    password = String(form.get("password") ?? "");
+  const role = field(form, "role", 20),
+    clientId = field(form, "client_id", 36),
+    membership = field(form, "membership", 20);
+  if (!name || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email))
+    throw new Error("Enter a name and valid email address.");
+  if (password && (password.length < 12 || password.length > 512))
+    throw new Error("Use a password between 12 and 512 characters.");
+  if (!["admin", "client"].includes(role))
+    throw new Error("Choose an account role.");
+  if (
+    role === "client" &&
+    (!uuid.test(clientId) || !["owner", "viewer"].includes(membership))
+  )
+    throw new Error("Choose a client workspace and access level.");
+  return { name, email, password, role, clientId, membership };
+}
