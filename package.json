{
  "name": "profuzion-client-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port ${PORT:-3000}",
    "db:setup": "node --env-file-if-exists=.env.local scripts/setup.js",
    "check": "tsc --noEmit",
    "start:cloudways": "node scripts/prepare.mjs && next start --hostname 127.0.0.1 --port ${PORT:-3000}",
    "test:portal": "npm run build && node scripts/test-portal.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "nodemailer": "^10.6.1",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@electric-sql/pglite-socket": "^0.3.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  }
}
