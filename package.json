{
  "name": "profuzion-client-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port ${PORT:-3000}",
    "db:setup": "node --env-file-if-exists=.env.local scripts/setup.js",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "start:cloudways": "node scripts/prepare.mjs && next start --hostname 127.0.0.1 --port ${PORT:-3000}"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "pg": "^8.16.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "esbuild": "^0.25.0"
  }
}
